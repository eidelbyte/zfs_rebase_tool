# yw row07: base ({A}x,{B}x) from ({AB}x) onto ({A}x,{B}z) [strict]
# verdict: conflict disagree
tree base
/A file x
/B file x
tree from
/A file x
/B link /A
tree onto
/A file x
/B file z
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 1
/
    A conflict 1
    B conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 disagree
  why  /A and /B end in one pool with different contents
  base ({/A}x,{/B}x)
  from ({/A /B}x)
  onto ({/A}x,{/B}y)
