# s2 same-path-new-bytes: base ({AB}x) from ({B}x,{A}y) onto ({AB}x) [strict]
# verdict: ({A}y,{B}x)
tree base
/A file x
/B link /A
tree from
/A file y
/B file x
tree onto
/A file x
/B link /A
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 2
#conflicts 0
/
    A write /A
    B cp /B
    ..
