# th v1-unilateral-split: base ({AB}v) from ({A}v,{B}v) onto ({AB}v) [strict]
# verdict: ({A}v,{B}v)
tree base
/A file v
/B link /A
tree from
/A file v
/B file v
tree onto
/A file v
/B link /A
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 1
#conflicts 0
/
    B cp /B
    ..
