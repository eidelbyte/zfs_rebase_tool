# s2 sever-and-join: base ({ABC},{DE}) from ({BC},{A},{DE}) onto ({BC},{ADE}) [strict]
# verdict: ({A D E}c,{B C}c)
tree base
/A file c
/B link /A
/C link /A
/D file c
/E link /D
tree from
/A file c
/B file c
/C link /B
/D file c
/E link /D
tree onto
/A file c
/D link /A
/E link /A
/B file c
/C link /B
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 0
#conflicts 0
/
    ..
