# gr row04: base ({AB},{C}) from ({A},{B},{C}) onto ({ABC}) [strict]
# verdict: conflict healed-split
tree base
/A file c
/B link /A
/C file c
tree from
/A file c
/B file c
/C file c
tree onto
/A file c
/B link /A
/C link /A
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 1
/
    A conflict 1
    B conflict 1
    C conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 healed-split
  why  /A and /B were split on one side and joined by the other
  base ({/A /B}x,{/C}x)
  from ({/A}x,{/C}x,{/B}x)
  onto ({/A /B /C}x)
