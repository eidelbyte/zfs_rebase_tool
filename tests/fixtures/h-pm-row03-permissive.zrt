# pm row03: base ({A}x,{B}y) from ({AB}x) onto ({A}z,{B}y) [permissive]
# verdict: ({A B}z)
tree base
/A file x
/B file y
tree from
/A file x
/B link /A
tree onto
/A file z
/B file y
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode permissive-merge
#actions 1
#conflicts 0
/
    B ln /A
    ..
