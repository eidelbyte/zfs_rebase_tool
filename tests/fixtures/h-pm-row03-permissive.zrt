# pm row03: base ({A}x,{B}y) from ({AB}x) onto ({A}z,{B}y) [permissive]
# verdict: ({A B}z)
tree base
/A file x
/B file y
tree from
/A file x
/B link /A
tree onto
/A file z
/B file y
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode permissive-merge
#actions 1
#conflicts 0
/
    B ln /A
    ..
