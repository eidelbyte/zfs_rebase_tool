# gr row18: base ({AB},{C}) from ({A},{BC}) onto ({A},{C}) [strict]
# verdict: ({A}c,{C}c)
tree base
/A file c
/B link /A
/C file c
tree from
/A file c
/B file c
/C link /B
tree onto
/A file c
/C file c
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 0
/
    ..
