# gr row18: base ({AB},{C}) from ({A},{BC}) onto ({A},{C}) [strict]
# verdict: ({A}c,{C}c)
tree base
/A file c
/B link /A
/C file c
tree from
/A file c
/B file c
/C link /B
tree onto
/A file c
/C file c
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 0
#conflicts 0
/
    ..
