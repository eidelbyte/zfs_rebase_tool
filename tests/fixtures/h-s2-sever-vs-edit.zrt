# s2 sever-vs-edit: base ({ABC}x) from ({BC}x,{A}x) onto ({ABC}y) [strict]
# verdict: ({A}y,{B C}y)
tree base
/A file x
/B link /A
/C link /A
tree from
/A file x
/B file x
/C link /B
tree onto
/A file y
/B link /A
/C link /A
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 2
#conflicts 0
/
    B dup /A
    C ln /B
    ..
