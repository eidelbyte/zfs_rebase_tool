# gr row06: base ({ABCD}) from ({AB},{CD}) onto ({AC},{BD}) [strict]
# verdict: ({A}c,{B}c,{C}c,{D}c)
tree base
/A file c
/B link /A
/C link /A
/D link /A
tree from
/A file c
/B link /A
/C file c
/D link /C
tree onto
/A file c
/C link /A
/B file c
/D link /B
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 2
#conflicts 0
/
    C cp /C
    D cp /D
    ..
