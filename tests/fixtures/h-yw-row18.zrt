# yw row18: base ({A}x) from ({A}x,{X}q) onto ({A}x,{X}r) [strict]
# verdict: conflict disagree
tree base
/A file x
tree from
/A file x
/X file q
tree onto
/A file x
/X file r
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 1
/
    X conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 disagree
  why  /X and ? end in one pool with different contents
  base ()
  from ({/X}x)
  onto ({/X}y)
