# s2 both-sever: base ({ABC}) from ({BC},{A}) onto ({BC},{A}) [strict]
# verdict: ({A}c,{B C}c)
tree base
/A file c
/B link /A
/C link /A
tree from
/A file c
/B file c
/C link /B
tree onto
/A file c
/B file c
/C link /B
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 0
/
    ..
