# s2 trap-rename-src-vs-pool: base ({A}m) from ({R}m) onto ({AS}m) [strict]
# verdict: conflict orphaned-add
tree base
/A file m
tree from
/R file m
tree onto
/A file m
/S link /A
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 1
#conflicts 1
/
    A conflict 1
    R cp /R
    S conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 orphaned-add
  why  /S was added to a pool the other side deleted
  base ()
  from ()
  onto ({/A /S}x)
