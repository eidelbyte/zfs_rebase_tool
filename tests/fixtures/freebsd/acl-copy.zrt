platform freebsd

# A from-only file carrying a non-trivial NFSv4 ACL. A name base
# never had has nothing to defend, so the pool is copied whole and
# the ACL travels with the other attributes the action carries; the
# manifest has no more to say about it than flags-copy.zrt has to
# say about nodump.
#
# The box's part is that the copy really carries it. A cp that wrote
# the bytes and left the ACL behind leaves the result unequal to
# from, and the harness's second --posix rebase would declare the
# action a second time.
#
# Box only: an NFSv4 ACL is FreeBSD's.

tree base
	/A file x

tree from
	/A file x
	/N file n acl=user:1:rw-p--aARWcCos:------:allow,owner@:rw-p--aARWcCos:------:allow,group@:r-----a-R-c--s:------:allow,everyone@:r-----a-R-c--s:------:allow

tree onto
	/A file x

expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 1
#conflicts 0
/
    N cp /N
    ..
