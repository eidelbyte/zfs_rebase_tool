platform freebsd

# One file, no flags in base, hidden on from and nodump on onto. Both
# sides changed it away from base and away from each other, and the
# file flags are part of the attribute set the content handle folds
# in, so the verdict is changed-both, exactly as it would be for
# bytes or for an extended attribute. The token is x in all three
# trees; the flags are the whole of the difference.
#
# Box only, so that the verdict is shown on the target: ZFS holds
# only some of the flags chflags(1) names (nodump, hidden, uarch,
# rdonly, offline, sparse, system, and the system flags), and
# answers uchg with EOPNOTSUPP -- which is why this fixture turns on
# hidden and not uchg. Nothing here holds a tree down; a harness
# still clears flags before it removes a built tree (chflags -R
# nouchg,nouappnd,noschg,nosappnd), as FORMAT.md tells it to. The
# conflict means nothing is applied, so no flag reaches the result;
# it is the two input sides that carry them.

tree base
	/A file x

tree from
	/A file x flags=hidden

tree onto
	/A file x flags=nodump

expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 1
/
    A conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 changed-both
  why  /A changed on both sides
  base ({/A}x)
  from ({/A}y)
  onto ({/A}z)
