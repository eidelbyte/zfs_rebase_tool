platform freebsd

# One name, one system-namespace attribute, three values: both sides
# changed it away from base and away from each other, which is
# changed-both. The bytes never move. xattr-conflict.zrt is the same
# shape in the user namespace, and this one proves the namespace the
# Mac cannot see reaches the content handle just as that one does.
#
# Box only, and root only, for the reason sysxattr-add.zrt gives.

tree base
	/A file x xattr=system.tag:base

tree from
	/A file x xattr=system.tag:from

tree onto
	/A file x xattr=system.tag:onto

expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 1
/
    A conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 changed-both
  why  /A changed on both sides
  base ({/A}x)
  from ({/A}y)
  onto ({/A}z)
