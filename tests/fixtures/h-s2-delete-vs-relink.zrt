# s2 delete-vs-relink: base ({AB}) from ({B}) onto ({ABC}) [strict]
# verdict: ({B C}c)
tree base
/A file c
/B link /A
tree from
/B file c
tree onto
/A file c
/B link /A
/C link /A
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 3
#conflicts 0
/
    A rm
    B cp /B
    C ln /B
    ..
