# s2 delete-vs-relink: base ({AB}) from ({B}) onto ({ABC}) [strict]
# verdict: ({B C}c)
tree base
/A file c
/B link /A
tree from
/B file c
tree onto
/A file c
/B link /A
/C link /A
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 3
#conflicts 0
/
    A rm
    B cp /B
    C ln /B
    ..
