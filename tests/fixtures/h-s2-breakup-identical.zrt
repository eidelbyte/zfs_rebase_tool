# s2 breakup-identical: base ({AB}x) from ({B}x,{A}x) onto ({AB}x) [strict]
# verdict: ({A}x,{B}x)
tree base
/A file x
/B link /A
tree from
/A file x
/B file x
tree onto
/A file x
/B link /A
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 1
#conflicts 0
/
    B cp /B
    ..
