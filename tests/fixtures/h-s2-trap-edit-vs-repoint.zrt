# s2 trap-edit-vs-repoint: base ({A}m,{Q}q) from ({A}n,{Q}q) onto ({AQ}q) [strict]
# verdict: conflict changed-both
tree base
/A file m
/Q file q
tree from
/A file n
/Q file q
tree onto
/A file q
/Q link /A
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 1
/
    A conflict 1
    Q conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 changed-both
  why  /A changed on both sides
  base ({/A}x,{/Q}y)
  from ({/A}z,{/Q}y)
  onto ({/A /Q}y)
