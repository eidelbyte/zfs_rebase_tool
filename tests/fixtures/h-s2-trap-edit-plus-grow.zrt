# s2 trap-edit-plus-grow: base ({AB}x) from ({AB}y) onto ({ABC}x) [strict]
# verdict: ({A B C}y)
tree base
/A file x
/B link /A
tree from
/A file y
/B link /A
tree onto
/A file x
/B link /A
/C link /A
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 1
#conflicts 0
/
    A write /A
    ..
