# s2 trap-edit-plus-grow: base ({AB}x) from ({AB}y) onto ({ABC}x) [strict]
# verdict: ({A B C}y)
tree base
/A file x
/B link /A
tree from
/A file y
/B link /A
tree onto
/A file x
/B link /A
/C link /A
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 1
#conflicts 0
/
    A write /A
    ..
