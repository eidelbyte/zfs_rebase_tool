# pm row06: base ({AB}a,{CD}c,{P}p) from ({ABP}a,{CD}c) onto ({AB}a,{CDP}c) [permissive]
# verdict: conflict changed-both
tree base
/A file a
/B link /A
/C file c
/D link /C
/P file p
tree from
/A file a
/B link /A
/P link /A
/C file c
/D link /C
tree onto
/A file a
/B link /A
/C file c
/D link /C
/P link /C
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode permissive-merge
#actions 0
#conflicts 1
/
    A conflict 1
    B conflict 1
    C conflict 1
    D conflict 1
    P conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 changed-both,disagree
  why  /P changed on both sides
  base ({/A /B}x,{/C /D}y,{/P}z)
  from ({/A /B /P}x,{/C /D}y)
  onto ({/A /B}x,{/C /D /P}y)
