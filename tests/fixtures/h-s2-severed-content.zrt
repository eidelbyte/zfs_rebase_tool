# s2 severed-content: base ({AB}x) from ({B}y,{A}x) onto ({AB}y) [strict]
# verdict: ({A}y,{B}y)
tree base
/A file x
/B link /A
tree from
/A file x
/B file y
tree onto
/A file y
/B link /A
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 1
#conflicts 0
/
    B cp /B
    ..
