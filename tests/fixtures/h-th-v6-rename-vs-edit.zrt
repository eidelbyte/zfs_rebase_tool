# th v6-rename-vs-edit: base ({A}v) from ({X}v) onto ({A}w) [strict]
# verdict: conflict changed-both
tree base
/A file v
tree from
/X file v
tree onto
/A file w
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 1
#conflicts 1
/
    A conflict 1
    X cp /X
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 changed-both
  why  /A changed on both sides
  base ()
  from ()
  onto ({/A}x)
