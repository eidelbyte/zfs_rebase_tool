# gr row03: base ({AB},{CD}) from ({AB},{CDE}) onto ({ABC}) [strict]
# verdict: ({A B C E}c)
tree base
/A file c
/B link /A
/C file c
/D link /C
tree from
/A file c
/B link /A
/C file c
/D link /C
/E link /C
tree onto
/A file c
/B link /A
/C link /A
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 1
#conflicts 0
/
    E ln /A
    ..
