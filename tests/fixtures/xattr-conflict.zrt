# One name, one attribute, three values: both sides changed it away
# from base and away from each other, which is changed-both. The
# bytes never move.

tree base
	/A file x xattr=user.tag:base

tree from
	/A file x xattr=user.tag:from

tree onto
	/A file x xattr=user.tag:onto

expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 1
/
    A conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 changed-both
  why  /A changed on both sides
  base ({/A}x)
  from ({/A}y)
  onto ({/A}z)
