# th name-both-rehome: base ({A}a,{B}b,{C}c) from ({AB}b,{C}c) onto ({AC}c,{B}b) [strict]
# verdict: conflict unexpressed-sharing
tree base
/A file a
/B file b
/C file c
tree from
/A file b
/B link /A
/C file c
tree onto
/A file c
/C link /A
/B file b
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 1
/
    A conflict 1
    B conflict 1
    C conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 unexpressed-sharing,changed-both,disagree
  why  /C and /B would share a pool that neither side joined
  base ({/A}x,{/C}y,{/B}z)
  from ({/A /B}z,{/C}y)
  onto ({/A /C}y,{/B}z)
