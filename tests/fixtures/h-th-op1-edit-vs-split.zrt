# th op1-edit-vs-split: base ({AB}x) from ({A}x,{B}x) onto ({AB}y) [strict]
# verdict: ({A}y,{B}y)
tree base
/A file x
/B link /A
tree from
/A file x
/B file x
tree onto
/A file y
/B link /A
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 1
#conflicts 0
/
    B dup /A
    ..
