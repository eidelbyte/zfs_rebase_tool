# s2 trap-two-new-pools: base () from ({A}x) onto ({B}y) [strict]
# verdict: ({A}x,{B}y)
tree base
tree from
/A file x
tree onto
/B file y
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 1
#conflicts 0
/
    A cp /A
    ..
