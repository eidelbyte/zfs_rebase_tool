# pm row05: base ({AB}a,{CD}a,{P}a) from ({ABP}a,{CD}a) onto ({AB}a,{CDP}a) [strict]
# verdict: conflict unexpressed-sharing
tree base
/A file a
/B link /A
/C file a
/D link /C
/P file a
tree from
/A file a
/B link /A
/P link /A
/C file a
/D link /C
tree onto
/A file a
/B link /A
/C file a
/D link /C
/P link /C
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 1
/
    A conflict 1
    B conflict 1
    C conflict 1
    D conflict 1
    P conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 unexpressed-sharing
  why  /A and /C would share a pool that neither side joined
  base ({/A /B}x,{/C /D}x,{/P}x)
  from ({/A /B /P}x,{/C /D}x)
  onto ({/A /B}x,{/C /D /P}x)
