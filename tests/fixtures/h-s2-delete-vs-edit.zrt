# s2 delete-vs-edit: base ({AB}x) from () onto ({AB}y) [strict]
# verdict: conflict changed-both
tree base
/A file x
/B link /A
tree from
tree onto
/A file y
/B link /A
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 1
/
    A conflict 1
    B conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 changed-both
  why  /A changed on both sides
  base ()
  from ()
  onto ({/A /B}x)
