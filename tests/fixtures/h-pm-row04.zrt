# pm row04: base ({A}x,{B}y,{C}z) from ({ABC}x) onto ({A}w,{B}y,{C}z) [strict]
# verdict: conflict disagree
tree base
/A file x
/B file y
/C file z
tree from
/A file x
/B link /A
/C link /A
tree onto
/A file w
/B file y
/C file z
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 0
#conflicts 1
/
    A conflict 1
    B conflict 1
    C conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 disagree
  why  /A and /B end in one pool with different contents
  base ({/A}x,{/B}y,{/C}z)
  from ({/A /B /C}x)
  onto ({/A}w,{/B}y,{/C}z)
