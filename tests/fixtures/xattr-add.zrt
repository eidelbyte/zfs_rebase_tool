# Two adds of an attribute where there was none: on a file onto kept
# unchanged, which is a write, and on a file only from has, which is
# a cp. The second attribute's value is empty, which is a value like
# any other and not the absence of one.

tree base
	/A file x

tree from
	/A file x xattr=user.new:v
	/N file n xattr=user.n:

tree onto
	/A file x

expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 2
#conflicts 0
/
    A write /A
    N cp /N
    ..
