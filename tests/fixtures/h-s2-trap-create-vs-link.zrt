# s2 trap-create-vs-link: base ({B}y) from ({A}y,{B}y) onto ({AB}y) [strict]
# verdict: conflict contested-home
tree base
/B file y
tree from
/A file y
/B file y
tree onto
/A file y
/B link /A
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 0
#conflicts 1
/
    A conflict 1
    B conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 contested-home
  why  /A was created on both sides in different pools
  base ({/B}x)
  from ({/A}x,{/B}x)
  onto ({/A /B}x)
