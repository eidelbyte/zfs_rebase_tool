# yw row09: base ({A}x,{B}y) from ({AB}z) onto ({A}x,{B}y) [strict]
# verdict: ({A B}z)
tree base
/A file x
/B file y
tree from
/A file z
/B link /A
tree onto
/A file x
/B file y
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 2
#conflicts 0
/
    A write /A
    B ln /A
    ..
