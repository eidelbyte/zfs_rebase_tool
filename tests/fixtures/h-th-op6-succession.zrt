# th op6-succession: base ({AB}x) from ({C}x,{B}x) onto ({Q}x,{D}x) [strict]
# verdict: ({C}x,{D}x,{Q}x)
tree base
/A file x
/B link /A
tree from
/B file x
/C file x
tree onto
/D file x
/Q file x
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 1
#conflicts 0
/
    C cp /C
    ..
