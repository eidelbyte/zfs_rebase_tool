# th v2a-two-splits: base ({ABC}v) from ({A}v,{BC}v) onto ({AB}v,{C}v) [strict]
# verdict: ({A}v,{B}v,{C}v)
tree base
/A file v
/B link /A
/C link /A
tree from
/A file v
/B file v
/C link /B
tree onto
/A file v
/B link /A
/C file v
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 1
#conflicts 0
/
    B cp /B
    ..
