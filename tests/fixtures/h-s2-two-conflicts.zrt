# s2 two-conflicts: base ({AB}x) from ({AB}y) onto ({ABC}z) [strict]
# verdict: conflict changed-both
tree base
/A file x
/B link /A
tree from
/A file y
/B link /A
tree onto
/A file z
/B link /A
/C link /A
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 1
/
    A conflict 1
    B conflict 1
    C conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 changed-both
  why  /A changed on both sides
  base ({/A /B}x)
  from ({/A /B}y)
  onto ({/A /B /C}z)
