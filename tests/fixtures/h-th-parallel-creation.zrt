# th parallel-creation: base () from ({A}y) onto ({A}z) [strict]
# verdict: conflict disagree
tree base
tree from
/A file y
tree onto
/A file z
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 1
/
    A conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 disagree
  why  /A and ? end in one pool with different contents
  base ()
  from ({/A}x)
  onto ({/A}y)
