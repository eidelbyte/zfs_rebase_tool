# s2 trap-delete-vs-sever: base ({AB}x) from ({B}x) onto ({B}x,{A}x) [strict]
# verdict: ({B}x)
tree base
/A file x
/B link /A
tree from
/B file x
tree onto
/A file x
/B file x
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 1
#conflicts 0
/
    A rm
    ..
