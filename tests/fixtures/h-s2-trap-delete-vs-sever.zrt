# s2 trap-delete-vs-sever: base ({AB}x) from ({B}x) onto ({B}x,{A}x) [strict]
# verdict: ({B}x)
tree base
/A file x
/B link /A
tree from
/B file x
tree onto
/A file x
/B file x
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 1
#conflicts 0
/
    A rm
    ..
