# s2 trap-rename-dest: base ({A}m,{Q}q) from ({R}m,{Q}q) onto ({A}m,{QR}q) [strict]
# verdict: conflict contested-home
tree base
/A file m
/Q file q
tree from
/Q file q
/R file m
tree onto
/A file m
/Q file q
/R link /Q
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 1
#conflicts 1
/
    A rm
    Q conflict 1
    R conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 contested-home,disagree
  why  /R was created on both sides in different pools
  base ({/Q}x)
  from ({/Q}x,{/R}y)
  onto ({/Q /R}x)
