# yw row06: base ({A}x,{B}y) from ({AB}x) onto ({A}x,{B}z) [strict]
# verdict: conflict changed-both
tree base
/A file x
/B file y
tree from
/A file x
/B link /A
tree onto
/A file x
/B file z
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 1
/
    A conflict 1
    B conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 changed-both
  why  /B changed on both sides
  base ({/A}x,{/B}y)
  from ({/A /B}x)
  onto ({/A}x,{/B}z)
