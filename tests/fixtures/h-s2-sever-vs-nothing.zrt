# s2 sever-vs-nothing: base ({ABC}) from ({BC},{A}) onto ({ABC}) [strict]
# verdict: ({A}c,{B C}c)
tree base
/A file c
/B link /A
/C link /A
tree from
/A file c
/B file c
/C link /B
tree onto
/A file c
/B link /A
/C link /A
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 2
#conflicts 0
/
    B cp /B
    C ln /B
    ..
