# s2 sever-vs-nothing: base ({ABC}) from ({BC},{A}) onto ({ABC}) [strict]
# verdict: ({A}c,{B C}c)
tree base
/A file c
/B link /A
/C link /A
tree from
/A file c
/B file c
/C link /B
tree onto
/A file c
/B link /A
/C link /A
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 2
#conflicts 0
/
    B cp /B
    C ln /B
    ..
