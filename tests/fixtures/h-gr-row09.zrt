# gr row09: base ({AB},{X}) from ({AX},{B}) onto ({A},{BX}) [strict]
# verdict: conflict healed-split
tree base
/A file c
/B link /A
/X file c
tree from
/A file c
/X link /A
/B file c
tree onto
/A file c
/B file c
/X link /B
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 0
#conflicts 1
/
    A conflict 1
    B conflict 1
    X conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 healed-split
  why  /A and /B were split on one side and joined by the other
  base ({/A /B}x,{/X}x)
  from ({/A /X}x,{/B}x)
  onto ({/A}x,{/B /X}x)
