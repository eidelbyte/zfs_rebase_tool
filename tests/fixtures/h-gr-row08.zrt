# gr row08: base ({ABC}) from ({AB},{C}) onto ({A},{BC}) [strict]
# verdict: ({A}c,{B}c,{C}c)
tree base
/A file c
/B link /A
/C link /A
tree from
/A file c
/B link /A
/C file c
tree onto
/A file c
/B file c
/C link /B
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 1
#conflicts 0
/
    C cp /C
    ..
