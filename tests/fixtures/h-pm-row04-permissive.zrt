# pm row04: base ({A}x,{B}y,{C}z) from ({ABC}x) onto ({A}w,{B}y,{C}z) [permissive]
# verdict: ({A B C}w)
tree base
/A file x
/B file y
/C file z
tree from
/A file x
/B link /A
/C link /A
tree onto
/A file w
/B file y
/C file z
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode permissive-merge
#actions 2
#conflicts 0
/
    B ln /A
    C ln /A
    ..
