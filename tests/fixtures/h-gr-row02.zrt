# gr row02: base ({ABCD}) from ({ABCD}) onto ({A},{B},{C}) [strict]
# verdict: ({A}c,{B}c,{C}c)
tree base
/A file c
/B link /A
/C link /A
/D link /A
tree from
/A file c
/B link /A
/C link /A
/D link /A
tree onto
/A file c
/B file c
/C file c
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 0
#conflicts 0
/
    ..
