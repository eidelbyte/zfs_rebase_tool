# gr row02: base ({ABCD}) from ({ABCD}) onto ({A},{B},{C}) [strict]
# verdict: ({A}c,{B}c,{C}c)
tree base
/A file c
/B link /A
/C link /A
/D link /A
tree from
/A file c
/B link /A
/C link /A
/D link /A
tree onto
/A file c
/B file c
/C file c
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 0
/
    ..
