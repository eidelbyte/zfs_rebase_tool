# gr row16: base ({AB},{C}) from ({ABX},{C}) onto ({A},{C}) [strict]
# verdict: ({A X}c,{C}c)
tree base
/A file c
/B link /A
/C file c
tree from
/A file c
/B link /A
/X link /A
/C file c
tree onto
/A file c
/C file c
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 1
#conflicts 0
/
    X ln /A
    ..
