# yw row19: base ({A}x) from ({A}x,{XY}q) onto ({A}x) [strict]
# verdict: ({A}x,{X Y}q)
tree base
/A file x
tree from
/A file x
/X file q
/Y link /X
tree onto
/A file x
expect
