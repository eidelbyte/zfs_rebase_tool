# yw row04: base ({A}x,{B}y) from ({AB}x) onto ({A}x,{B}y) [strict]
# verdict: ({A B}x)
tree base
/A file x
/B file y
tree from
/A file x
/B link /A
tree onto
/A file x
/B file y
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 1
#conflicts 0
/
    B ln /A
    ..
