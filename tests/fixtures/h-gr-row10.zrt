# gr row10: base ({A},{BC}) from ({B},{C}) onto ({ABC}) [strict]
# verdict: ({B}c,{C}c)
tree base
/A file c
/B file c
/C link /B
tree from
/B file c
/C file c
tree onto
/A file c
/B link /A
/C link /A
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 3
#conflicts 0
/
    A rm
    B cp /B
    C cp /C
    ..
