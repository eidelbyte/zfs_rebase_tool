# gr row10: base ({A},{BC}) from ({B},{C}) onto ({ABC}) [strict]
# verdict: ({B}c,{C}c)
tree base
/A file c
/B file c
/C link /B
tree from
/B file c
/C file c
tree onto
/A file c
/B link /A
/C link /A
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 3
#conflicts 0
/
    A rm
    B cp /B
    C cp /C
    ..
