# gr row11: base ({AB}) from ({A}) onto ({B}) [strict]
# verdict: ()
tree base
/A file c
/B link /A
tree from
/A file c
tree onto
/B file c
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 1
#conflicts 0
/
    B rm
    ..
