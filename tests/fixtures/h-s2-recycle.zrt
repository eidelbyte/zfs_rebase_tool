# s2 recycle: base ({AB}x) from ({C}y) onto ({AB}x) [strict]
# verdict: ({C}y)
tree base
/A file x
/B link /A
tree from
/C file y
tree onto
/A file x
/B link /A
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 3
#conflicts 0
/
    A rm
    B rm
    C cp /C
    ..
