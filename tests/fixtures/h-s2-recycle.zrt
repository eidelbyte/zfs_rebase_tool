# s2 recycle: base ({AB}x) from ({C}y) onto ({AB}x) [strict]
# verdict: ({C}y)
tree base
/A file x
/B link /A
tree from
/C file y
tree onto
/A file x
/B link /A
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 3
#conflicts 0
/
    A rm
    B rm
    C cp /C
    ..
