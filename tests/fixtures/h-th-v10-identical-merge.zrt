# th v10-identical-merge: base ({A}a,{B}b) from ({AB}a) onto ({AB}a) [strict]
# verdict: ({A B}a)
tree base
/A file a
/B file b
tree from
/A file a
/B link /A
tree onto
/A file a
/B link /A
expect
#rebase-manifest 4
#base zrt/base@s
