# s2 gone-vs-standalone: base ({AB}) from ({B}) onto ({B},{A}) [strict]
# verdict: ({B}c)
tree base
/A file c
/B link /A
tree from
/B file c
tree onto
/A file c
/B file c
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 1
#conflicts 0
/
    A rm
    ..
