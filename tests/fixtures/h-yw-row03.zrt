# yw row03: base ({A}x) from ({A}y) onto ({A}z) [strict]
# verdict: conflict changed-both
tree base
/A file x
tree from
/A file y
tree onto
/A file z
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 1
/
    A conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 changed-both
  why  /A changed on both sides
  base ({/A}x)
  from ({/A}y)
  onto ({/A}z)
