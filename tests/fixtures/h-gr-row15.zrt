# gr row15: base ({AB},{C}) from ({ABX},{C}) onto ({C}) [strict]
# verdict: conflict orphaned-add
tree base
/A file c
/B link /A
/C file c
tree from
/A file c
/B link /A
/X link /A
/C file c
tree onto
/C file c
expect
#rebase-manifest 4
#base zrt/base@s
#from zrt/from@s
#onto zrt/onto@s
#mode strict
#actions 0
#conflicts 1
/
    X conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 orphaned-add
  why  /X was added to a pool the other side deleted
  base ()
  from ({/X /A /B}x)
  onto ()
