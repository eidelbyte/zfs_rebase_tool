# gr row15: base ({AB},{C}) from ({ABX},{C}) onto ({C}) [strict]
# verdict: conflict orphaned-add
tree base
/A file c
/B link /A
/C file c
tree from
/A file c
/B link /A
/X link /A
/C file c
tree onto
/C file c
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 0
#conflicts 1
/
    A conflict 1
    B conflict 1
    X conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 orphaned-add
  why  /X was added to a pool the other side deleted
  base ()
  from ({/A /B /X}x)
  onto ()
