# th v8-double-rename-pair: base ({AB}v) from ({XB}v) onto ({AY}v) [strict]
# verdict: conflict orphaned-add
tree base
/A file v
/B link /A
tree from
/B file v
/X link /B
tree onto
/A file v
/Y link /A
expect
#rebase-manifest 5
#result -
#form posix
#base base 0
#from from 0
#onto onto 0
#made -
#tag -
#take -
#written -
#mode strict
#actions 0
#conflicts 2
/
    A conflict 1
    B conflict 2
    X conflict 2
    Y conflict 1
    ..

# a pool is one file and all its names: {names}letter; same
# letter, same bytes
conflict 1 orphaned-add
  why  /Y was added to a pool the other side deleted
  base ()
  from ()
  onto ({/A /Y}x)
conflict 2 orphaned-add
  why  /X was added to a pool the other side deleted
  base ()
  from ({/B /X}x)
  onto ()
