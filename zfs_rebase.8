.Dd September 4, 2026
.Dt ZFS_REBASE 8
.Os
.Sh NAME
.Nm zfs_rebase
.Nd rebase one ZFS filesystem onto another
.Sh SYNOPSIS
.Nm
.Op Fl p | Fl -permissive-merge
.Op Fl v | Fl -verbose
.Op Fl o | Fl -manifest Ar file
.Op Fl V | Fl -verify
.Op Fl w | Fl -overwrite
.Oo Fl u | Fl -allow-unrelated Oo Fl b | Fl -base Ar snapshot Oc Oc
.Oo Fl O | Fl -take-onto | Fl F | Fl -take-from Oc
.Op Fl G | Fl -no-gui
.Op Fl M | Fl -no-merge
.Fl f | Fl -from Ar snapshot Ns | Ns Ar dataset
.Fl t | Fl -onto Ar snapshot Ns | Ns Ar dataset
.Fl r | Fl -result Ar name
.Nm
.Fl n | Fl -dry-run
.Op Fl p | Fl -permissive-merge
.Op Fl o | Fl -manifest Ar file
.Fl f | Fl -from Ar snapshot Ns | Ns Ar dataset
.Fl t | Fl -onto Ar snapshot Ns | Ns Ar dataset
.Nm
.Fl c | Fl -continue
.Op Fl V | Fl -verify
.Op Fl G | Fl -no-gui
.Op Fl M | Fl -no-merge
.Op Fl v | Fl -verbose
.Fl r | Fl -result Ar dataset
.Nm
.Fl R | Fl -restart
.Op Fl v | Fl -verbose
.Fl r | Fl -result Ar dataset
.Nm
.Fl a | Fl -abort
.Op Fl v | Fl -verbose
.Fl r | Fl -result Ar dataset
.Nm
.Fl V | Fl -verify
.Op Fl v | Fl -verbose
.Fl r | Fl -result Ar dataset
.Nm
.Fl -posix
