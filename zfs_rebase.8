.Op Fl p | Fl -permissive-merge
.Op Fl o | Fl -manifest Ar file
.Fl f | Fl -from Ar snapshot Ns | Ns Ar dataset
.Fl t | Fl -onto Ar snapshot Ns | Ns Ar dataset
.Nm
.Fl c | Fl -continue
.Op Fl i | Fl -interactive Op Ar command
.Op Fl M | Fl -no-merge
.Op Fl v | Fl -verbose
.Op Fl f | Fl -from Ar snapshot
.Op Fl t | Fl -onto Ar snapshot
.Ar ident
.Nm
.Fl R | Fl -restart
.Op Fl v | Fl -verbose
